# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO RENDER.COM
# ==========================================

# Môi trường chạy (Production)
NODE_ENV=production

# Render sẽ tự động cấp PORT (mặc định 10000), không bắt buộc phải điền PORT
PORT=10000

# 1. Kết nối cơ sở dữ liệu MongoDB Atlas (Bắt buộc)
MONGODB_URI=your_mongodb_connection_string

# 2. Khóa bí mật mã hóa phiên đăng nhập JWT (Bắt buộc, tối thiểu 32 ký tự)
AUTH_SECRET=your_jwt_secret_key_at_least_32_characters
JWT_SECRET=your_jwt_secret_key_at_least_32_characters

# 3. Cấu hình Supabase Storage lưu trữ hình ảnh (Bắt buộc)
SUPABASE_SECRET_KEY=your_supabase_secret_key
NEXT_PUBLIC_SUPABASE_SECRET=your_supabase_secret_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# 4. Tên miền trang web (Tùy chọn: URL Render sau khi tạo service, ví dụ: https://your-blog.onrender.com)
NEXT_PUBLIC_SITE_URL=https://your-blog.onrender.com

# 5. Google Analytics & AdSense (Tùy chọn)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
